---
// SpamClaims 3D landing page: one Blender-rendered scroll story (blender/story.py), then the essentials.
// One mission: the CTA. Every CTA points at the app and forwards this page's query string (+ lp=3d).
import { ACTS, BEATS, FADE, STILLS } from '../data/story';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = (import.meta.env.SITE || 'https://themoee.github.io').replace(/\/$/, '');
const canonical = `${site}${base}/`;
const year = new Date().getFullYear();
const CTA_HREF = 'https://spamclaims.com/lp/stop?lp=3d';
const title = 'You said STOP. They kept texting. | SpamClaims';
const description =
  'Still getting marketing texts after you replied STOP? See if your screenshots may qualify for attorney review. Free to check, no sign-up.';
const fontFace = `@font-face{font-family:'Inter';font-style:normal;font-weight:100 900;font-display:swap;src:url(${base}/fonts/inter-latin-opsz-normal.woff2) format('woff2')}`;

const steps = [
  { title: 'Upload', text: 'Send us the screenshots. The whole conversation, with the dates showing.' },
  { title: 'We investigate', text: 'SpamClaims organizes the messages and researches who sent them.' },
  { title: 'Attorney review', text: 'A participating attorney evaluates the evidence and the law.' },
  { title: 'If accepted', text: 'The attorney handles the legal process. You keep your screenshots and your phone.' },
];
const freePoints = [
  'Uploading your screenshots is free',
  'No cost to see if your texts may qualify',
  'Attorneys typically work on contingency: they get paid only if the case wins',
];
const faqs = [
  {
    q: 'Do I need to go to court?',
    a: 'Most TCPA claims are resolved without you ever stepping into a courtroom. If a case proceeds, the attorney handles it.',
  },
  {
    q: 'What kinds of texts may qualify?',
    a: "Marketing texts that kept coming after you replied STOP, texts you never agreed to receive, and marketing texts sent before 8 a.m. or after 9 p.m. your local time.",
  },
  {
    q: 'Is it really free?',
    a: 'Yes. Uploading and reviewing your screenshots costs nothing. If an attorney takes the case, they typically work on contingency.',
  },
  {
    q: 'What should I upload?',
    a: 'Screenshots of the whole conversation: the first text, your STOP reply, and everything that came after it, with the dates showing.',
  },
  {
    q: 'How long does it take?',
    a: 'Checking takes a couple of minutes. A claim itself can take months, depending on the facts and the company involved.',
  },
];
const beatJson = JSON.stringify(BEATS.map((b) => ({ id: b.id, in: b.in, out: b.out })));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000411" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="any" />
    <link rel="icon" type="image/png" sizes="512x512" href={`${base}/favicon-512.png`} />
    <link rel="apple-touch-icon" href={`${base}/favicon-512.png`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SpamClaims" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site}${base}/og.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A Cosmic Orange phone surrounded by floating spam texts" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site}${base}/og.jpg`} />
    <link rel="preload" href={`${base}/fonts/inter-latin-opsz-normal.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" as="image" href={`${base}/seq/desktop/0000.webp`} media="(min-aspect-ratio: 1/1)" fetchpriority="high" />
    <link rel="preload" as="image" href={`${base}/seq/mobile/0000.webp`} media="(max-aspect-ratio: 1/1)" fetchpriority="high" />
    <style is:inline set:html={fontFace}></style>
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <header class="top" id="top">
      <a class="brand" href={`${base}/`} aria-label="SpamClaims.com home">
        <img src={`${base}/logo-reversed@96.png`} width="323" height="96" alt="SpamClaims.com" />
      </a>
      <a class="btn btn-sm" data-cta="header" href={CTA_HREF}>Check my texts</a>
    </header>

    <section class="story" id="story" aria-label="What happens when they ignore your STOP">
      <div class="stage">
        <picture class="poster" aria-hidden="true">
          <source media="(max-aspect-ratio: 1/1)" srcset={`${base}/seq/mobile/0000.webp`} />
          <img src={`${base}/seq/desktop/0000.webp`} alt="" fetchpriority="high" decoding="async" />
        </picture>
        <canvas id="seq" aria-hidden="true"></canvas>
        <div class="scrim" aria-hidden="true"></div>
        <div class="beats">
          {BEATS.map((b) => (
            <article class={`beat beat--${b.id}${b.tone ? ` tone-${b.tone}` : ''}`} data-id={b.id}>
              {b.eyebrow && <p class="eyebrow">{b.eyebrow}</p>}
              {b.heading === 'h1' ? (
                <h1 class="h1" set:html={b.title} />
              ) : b.heading === 'h3' ? (
                <h3 class="h3" set:html={b.title} />
              ) : (
                <h2 class="h2" set:html={b.title} />
              )}
              {b.body && <p class="lead">{b.body}</p>}
              {b.checks && (
                <ul class="checks">
                  {b.checks.map((c) => (
                    <li class={c.ok ? 'ok' : 'no'}>
                      <span class="mark" aria-hidden="true">{c.ok ? '✓' : '✕'}</span>
                      {c.text}
                    </li>
                  ))}
                </ul>
              )}
              {b.cta && (
                <div class="cta-row">
                  <a class="btn" data-cta={b.id} href={CTA_HREF}>Check my texts</a>
                  <span class="cta-note">Free to check · No sign-up</span>
                </div>
              )}
            </article>
          ))}
        </div>
        <nav class="rail" aria-label="Story chapters">
          {ACTS.map((a) => (
            <button type="button" data-t={a.t} aria-label={`Jump to: ${a.label}`}><span>{a.label}</span></button>
          ))}
        </nav>
        <div class="hint" aria-hidden="true"><span></span>Scroll</div>
      </div>
    </section>

    <main>
      <section class="section" id="how">
        <div class="container">
          <p class="eyebrow">How it works</p>
          <h2 class="h2">Four steps. You only do the first one.</h2>
          <ol class="steps">
            {steps.map((s, i) => (
              <li class="step">
                <span class="step-n" aria-hidden="true">{i + 1}</span>
                <h3 class="h4">{s.title}</h3>
                <p>{s.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="section" id="free">
        <div class="container two">
          <div>
            <p class="eyebrow">No cost to check</p>
            <h2 class="h2">Free to check.<br />Always.</h2>
          </div>
          <ul class="bullets">
            {freePoints.map((p) => (
              <li><span class="mark" aria-hidden="true">✓</span><span>{p}</span></li>
            ))}
          </ul>
        </div>
      </section>

      <section class="section" id="evidence">
        <div class="container narrow">
          <div class="card">
            <p class="eyebrow">Heads up</p>
            <h2 class="h2">Don't delete the evidence.</h2>
            <p class="lead">
              Old messages disappear when phones are replaced, threads are deleted or screenshots get lost. If you have
              the conversation now, screenshot it now. Legal deadlines can apply.
            </p>
          </div>
        </div>
      </section>

      <section class="section" id="faq">
        <div class="container narrow">
          <p class="eyebrow">Questions</p>
          <h2 class="h2">Straight answers.</h2>
          <div class="faqs">
            {faqs.map((f) => (
              <details class="faq">
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="section final" id="final">
        <div class="container narrow center">
          <img class="final-logo" src={`${base}/logo-reversed.png`} width="1498" height="444" alt="SpamClaims.com" loading="lazy" />
          <h2 class="h2">Still have the thread?</h2>
          <p class="lead muted">Upload the screenshots and see if your texts may qualify.</p>
          <a class="btn btn-lg" data-cta="final" href={CTA_HREF}>Check my texts</a>
          <p class="cta-note">Free to check · No sign-up</p>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="container">
        <img class="foot-logo" src={`${base}/logo-reversed@96.png`} width="323" height="96" alt="SpamClaims.com" loading="lazy" />
        <p class="disclaimer">
          This website does not provide legal advice. Submitting information does not create an attorney-client
          relationship. Results vary based on the facts and applicable law.
        </p>
        <p class="disclaimer small">
          SpamClaims.com provides consumer-submitted reporting and informational tools. Information displayed does not
          constitute legal advice or a determination of liability. Phones and messages shown are illustrations.
        </p>
        <p class="copyright">© {year} SpamClaims.com</p>
      </div>
    </footer>

    <div class="sticky-cta" id="sticky-cta">
      <a class="btn" data-cta="sticky" href={CTA_HREF}>Check my texts</a>
    </div>

    <script is:inline>
      // forward every query param to the app (+ lp=3d); vv names the ad video and stays as the ad set it
      (function () {
        try {
          var p = new URLSearchParams(location.search);
          p.set('lp', '3d');
          p.delete('notrack');
          var qs = p.toString();
          var links = document.querySelectorAll('a[data-cta]');
          for (var i = 0; i < links.length; i++) links[i].href = 'https://spamclaims.com/lp/stop?' + qs;
        } catch (e) {}
      })();
    </script>
    <script define:vars={{ beatJson, FADE, STILLS, base }}>
      window.__story = { beats: JSON.parse(beatJson), fade: FADE, stills: STILLS, base: base };
    </script>
    <script>
      import { startSequence } from '../scripts/sequence';
      import { track } from '../scripts/track';
      import { ACTS } from '../data/story';

      type B = { id: string; in: number; out: number };
      const cfg = (window as any).__story as { beats: B[]; fade: number; stills: number[]; base: string };
      const story = document.getElementById('story') as HTMLElement;
      const canvas = document.getElementById('seq') as HTMLCanvasElement;
      const poster = story.querySelector('.poster') as HTMLElement;
      const rail = Array.from(story.querySelectorAll<HTMLButtonElement>('.rail button'));
      const hint = story.querySelector('.hint') as HTMLElement;
      const els = new Map<string, HTMLElement>();
      story.querySelectorAll<HTMLElement>('.beat').forEach((el) => els.set(el.dataset.id!, el));
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const span = () => Math.max(1, story.offsetHeight - window.innerHeight);
      const progress = () => {
        const top = story.getBoundingClientRect().top;
        return Math.min(1, Math.max(0, -top / span()));
      };

      const sm = (x: number) => {
        const c = Math.min(1, Math.max(0, x));
        return c * c * (3 - 2 * c);
      };
      let lastT = -1;
      const paint = (t: number) => {
        if (Math.abs(t - lastT) < 0.0004) return;
        lastT = t;
        const f = cfg.fade;
        for (const b of cfg.beats) {
          const el = els.get(b.id);
          if (!el) continue;
          const vin = b.in < 0 ? 1 : sm((t - (b.in - f)) / f);
          const vout = b.out > 1 ? 1 : 1 - sm((t - (b.out - f)) / f);
          const o = Math.min(vin, vout);
          const dy = (vin < 1 ? (1 - vin) * 26 : 0) - (vout < 1 ? (1 - vout) * 26 : 0);
          el.style.opacity = o.toFixed(3);
          el.style.setProperty('--dy', `${dy.toFixed(1)}px`);
          el.classList.toggle('on', o > 0.02);
        }
        let act = 0;
        ACTS.forEach((a, i) => {
          if (t >= a.t - 0.005) act = i;
        });
        rail.forEach((r, i) => r.classList.toggle('on', i === act));
        hint.style.opacity = String(1 - sm(t / 0.03));
      };

      // analytics: how far people get, once per act
      // the header goes solid once the story has scrolled away (body copy must not run under a see-through bar)
      const topBar = document.getElementById('top') as HTMLElement;
      const solid = () => topBar.classList.toggle('solid', story.getBoundingClientRect().bottom < topBar.offsetHeight + 4);
      window.addEventListener('scroll', solid, { passive: true });
      solid();

      const reached = new Set<string>();
      const seen = (t: number) => {
        for (const a of ACTS) {
          if (t >= a.t && !reached.has(a.id)) {
            reached.add(a.id);
            if (a.id !== 'hero') track('lp3d_act', { act: a.id });
          }
        }
        if (t > 0.985 && !reached.has('done')) {
          reached.add('done');
          track('lp3d_story_complete');
        }
      };

      paint(progress());
      startSequence({
        canvas,
        base: cfg.base,
        target: progress,
        reducedMotion: reduced,
        stills: cfg.stills,
        onFrame: (t) => {
          paint(t);
          seen(t);
        },
        onFirstDraw: () => story.classList.add('live'),
        onReady: (info) => track('lp3d_frames_ready', info),
      });

      rail.forEach((r) =>
        r.addEventListener('click', () => {
          const t = Number(r.dataset.t);
          const top = story.getBoundingClientRect().top + window.scrollY;
          window.scrollTo({ top: top + t * span() + 2, behavior: reduced ? 'auto' : 'smooth' });
        }),
      );
      document.querySelectorAll<HTMLAnchorElement>('a[data-cta]').forEach((a) =>
        a.addEventListener('click', () => track('lp3d_cta_click', { where: a.dataset.cta, t: Number(lastT.toFixed(3)) })),
      );
      track('$pageview', { title: document.title });
      void poster;
    </script>

    <style is:global>
      :root {
        --bg: #000411;
        --bg-2: #050a1a;
        --fg: #f5f7fb;
        --muted: #a2abbd;
        --dim: #6f7a90;
        --line: rgb(255 255 255 / 0.09);
        --card: rgb(255 255 255 / 0.035);
        --orange: #f58220;
        --orange-2: #ff9d45;
        --green: #30d158;
        --amber: #ffcc4d;
        --navy: #24345a;
        --pad-x: max(6vw, 24px);
        --header-h: 64px;
        --sans: 'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
        color-scheme: dark;
      }
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      html, body { margin: 0; background: var(--bg); color: var(--fg); overflow-x: clip; }
      body { font-family: var(--sans); font-size: 17px; line-height: 1.55; -webkit-font-smoothing: antialiased; font-optical-sizing: auto; }
      img, canvas { display: block; max-width: 100%; }
      a { color: inherit; }
      .container { width: 100%; max-width: 1160px; margin: 0 auto; padding: 0 var(--pad-x); }
      .container.narrow { max-width: 820px; }
      .center { text-align: center; }

      /* type */
      .h1, .h2, .h3, .h4 { font-family: var(--sans); margin: 0; text-wrap: balance; }
      .h1 { font-size: clamp(36px, min(5.4vw, 8.6vh), 84px); line-height: 0.98; font-weight: 800; letter-spacing: -0.04em; }
      .h2 { font-size: clamp(30px, min(4.3vw, 7.2vh), 64px); line-height: 1.02; font-weight: 780; letter-spacing: -0.035em; }
      .h3 { font-size: clamp(26px, min(3vw, 5.6vh), 44px); line-height: 1.05; font-weight: 760; letter-spacing: -0.03em; }
      .h4 { font-size: 21px; line-height: 1.2; font-weight: 700; letter-spacing: -0.015em; margin: 14px 0 6px; }
      .eyebrow { font-size: 13px; font-weight: 650; letter-spacing: 0.16em; text-transform: uppercase; color: var(--orange-2); margin: 0 0 14px; }
      .lead { font-size: clamp(16px, min(1.35vw, 2.7vh), 21px); line-height: 1.5; color: #d5dbe7; margin: 18px 0 0; max-width: 30em; }
      .muted { color: var(--muted); }

      /* buttons */
      .btn {
        display: inline-flex; align-items: center; justify-content: center; min-height: 54px; padding: 0 30px;
        border-radius: 999px; text-decoration: none; font-weight: 700; font-size: 17px; letter-spacing: -0.005em;
        color: #fff; background: linear-gradient(180deg, var(--orange-2), var(--orange) 70%);
        box-shadow: 0 10px 30px -8px rgb(245 130 32 / 0.55), inset 0 1px 0 rgb(255 255 255 / 0.25);
        transition: transform 0.15s ease, box-shadow 0.15s ease, filter 0.15s ease;
        -webkit-tap-highlight-color: transparent; white-space: nowrap;
      }
      .btn:hover { transform: translateY(-1px); filter: brightness(1.06); box-shadow: 0 14px 36px -8px rgb(245 130 32 / 0.65), inset 0 1px 0 rgb(255 255 255 / 0.25); }
      .btn:active { transform: translateY(1px); }
      .btn:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
      .btn-sm { min-height: 40px; padding: 0 18px; font-size: 15px; box-shadow: 0 6px 18px -6px rgb(245 130 32 / 0.6); }
      .btn-lg { min-height: 62px; padding: 0 40px; font-size: 19px; }
      .cta-row { display: flex; align-items: center; flex-wrap: wrap; gap: 12px 18px; margin-top: 28px; }
      .cta-note { font-size: 14px; color: var(--muted); }

      /* header */
      .top {
        position: fixed; inset: 0 0 auto 0; z-index: 40; height: var(--header-h);
        display: flex; align-items: center; justify-content: space-between; gap: 16px;
        padding: 0 var(--pad-x); padding-top: env(safe-area-inset-top);
        background: linear-gradient(180deg, rgb(0 4 17 / 0.85), rgb(0 4 17 / 0));
      }
      .top { transition: background-color 0.25s ease, border-color 0.25s ease; border-bottom: 1px solid transparent; }
      .top.solid { background: rgb(0 4 17 / 0.9); -webkit-backdrop-filter: blur(14px) saturate(1.4); backdrop-filter: blur(14px) saturate(1.4); border-bottom-color: var(--line); }
      .brand img { height: 38px; width: auto; }

      /* the story */
      .story { position: relative; height: 100vh; }
      .js .story { height: 1250vh; }
      .stage { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; background: var(--bg); }
      .poster, .poster img, #seq { position: absolute; inset: 0; width: 100%; height: 100%; }
      .poster img { object-fit: cover; object-position: 62% 50%; }
      #seq { opacity: 0; transition: opacity 0.35s ease; }
      .story.live #seq { opacity: 1; }
      .scrim {
        position: absolute; inset: 0; pointer-events: none;
        background: linear-gradient(90deg, rgb(0 4 17 / 0.9) 0%, rgb(0 4 17 / 0.62) 28%, rgb(0 4 17 / 0.12) 48%, rgb(0 4 17 / 0) 56%);
      }
      .beats { position: absolute; inset: 0; pointer-events: none; }
      .beat {
        position: absolute; left: var(--pad-x); top: calc(var(--header-h) + (100% - var(--header-h)) * 0.5); width: min(560px, 42vw);
        transform: translate3d(0, calc(-50% + var(--dy, 0px)), 0); opacity: 0; visibility: hidden;
        will-change: opacity, transform;
      }
      .beat.on { visibility: visible; pointer-events: auto; }
      .beat--hero { opacity: 1; visibility: visible; pointer-events: auto; }
      html:not(.js) .beat:not(.beat--hero) { display: none; }
      .beat .h3 { margin-top: 2px; }
      .tone-strong .eyebrow { color: var(--green); }
      .tone-maybe .eyebrow { color: var(--amber); }
      .tone-weak .eyebrow { color: var(--muted); }
      .checks { list-style: none; padding: 0; margin: 22px 0 0; display: grid; gap: 10px; font-size: 18px; color: #dfe4ee; }
      .checks li { display: flex; align-items: center; gap: 12px; }
      .checks .no { color: var(--muted); }
      .mark { flex: none; display: inline-grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; font-size: 13px; font-weight: 800; background: rgb(255 255 255 / 0.08); color: var(--muted); }
      .ok .mark, .bullets .mark { background: var(--green); color: #00210a; }

      .rail { position: absolute; right: max(2.2vw, 14px); top: 50%; transform: translateY(-50%); display: grid; gap: 14px; z-index: 3; }
      .rail button { all: unset; cursor: pointer; position: relative; width: 10px; height: 10px; border-radius: 50%; background: rgb(255 255 255 / 0.22); transition: background 0.2s, transform 0.2s; }
      .rail button span { position: absolute; right: 22px; top: 50%; transform: translateY(-50%); font-size: 12px; font-weight: 600; letter-spacing: 0.04em; color: var(--muted); white-space: nowrap; opacity: 0; transition: opacity 0.2s; }
      .rail button:hover span, .rail button:focus-visible span { opacity: 1; }
      .rail button.on { background: var(--orange); transform: scale(1.25); }
      .rail button:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
      .hint { position: absolute; left: 50%; bottom: 26px; transform: translateX(-50%); display: grid; justify-items: center; gap: 8px; font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); pointer-events: none; }
      .hint span { width: 1px; height: 34px; background: linear-gradient(180deg, transparent, var(--muted)); animation: drip 1.8s ease-in-out infinite; }
      @keyframes drip { 0% { transform: scaleY(0); transform-origin: top; } 50% { transform: scaleY(1); transform-origin: top; } 51% { transform-origin: bottom; } 100% { transform: scaleY(0); transform-origin: bottom; } }

      /* portrait: copy on top, phone below, CTA pinned at the bottom */
      @media (max-aspect-ratio: 1/1) {
        :root { --header-h: 58px; --pad-x: 20px; }
        .brand img { height: 30px; }
        .js .story { height: 1100vh; height: 1100svh; }
        .poster img { object-position: 50% 56%; }
        .scrim { background: linear-gradient(180deg, rgb(0 4 17 / 0.92) 0%, rgb(0 4 17 / 0.7) 22%, rgb(0 4 17 / 0.15) 38%, rgb(0 4 17 / 0) 44%), linear-gradient(0deg, rgb(0 4 17 / 0.85) 0%, rgb(0 4 17 / 0) 14%); }
        .beat { top: calc(var(--header-h) + env(safe-area-inset-top) + 10px); left: var(--pad-x); right: var(--pad-x); width: auto; transform: translate3d(0, var(--dy, 0px), 0); }
        .h1 { font-size: clamp(36px, 10.2vw, 52px); }
        .h2 { font-size: clamp(30px, 8.6vw, 44px); }
        .h3 { font-size: clamp(26px, 7.4vw, 36px); }
        .lead { font-size: 17px; margin-top: 12px; }
        .eyebrow { margin-bottom: 10px; }
        .checks { margin-top: 14px; font-size: 16px; gap: 7px; }
        .beat .cta-row { display: none; }
        .rail { display: none; }
        .hint { bottom: calc(96px + env(safe-area-inset-bottom)); }
      }
      @media (max-aspect-ratio: 1/1) and (max-height: 700px) {
        .beat .lead { display: none; }
      }

      /* sections after the story */
      .section { padding: 96px 0; border-top: 1px solid var(--line); }
      @media (min-width: 900px) { .section { padding: 128px 0; } }
      .steps { list-style: none; margin: 44px 0 0; padding: 0; display: grid; gap: 16px; }
      @media (min-width: 720px) { .steps { grid-template-columns: repeat(2, 1fr); } }
      @media (min-width: 1040px) { .steps { grid-template-columns: repeat(4, 1fr); } }
      .step { background: var(--card); border: 1px solid var(--line); border-radius: 22px; padding: 26px 24px 24px; }
      .step p { margin: 0; color: var(--muted); }
      .step-n { display: inline-grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; font-weight: 800; color: #fff; background: linear-gradient(180deg, var(--orange-2), var(--orange)); }
      .two { display: grid; gap: 36px; align-items: center; }
      @media (min-width: 900px) { .two { grid-template-columns: 1fr 1fr; } }
      .bullets { list-style: none; margin: 0; padding: 0; display: grid; gap: 18px; font-size: 19px; font-weight: 550; }
      .bullets li { display: flex; gap: 14px; align-items: flex-start; }
      .bullets .mark { margin-top: 1px; }
      .card { background: linear-gradient(180deg, rgb(245 130 32 / 0.09), rgb(245 130 32 / 0.02)); border: 1px solid rgb(245 130 32 / 0.35); border-radius: 28px; padding: 40px 28px; }
      @media (min-width: 720px) { .card { padding: 56px 56px; } }
      .faqs { display: grid; gap: 10px; margin-top: 36px; }
      .faq { background: var(--card); border: 1px solid var(--line); border-radius: 18px; padding: 0 22px; }
      .faq[open] { border-color: rgb(245 130 32 / 0.45); }
      .faq summary { cursor: pointer; list-style: none; padding: 20px 30px 20px 0; font-weight: 650; font-size: 17px; position: relative; }
      .faq summary::-webkit-details-marker { display: none; }
      .faq summary::after { content: '+'; position: absolute; right: 0; top: 50%; transform: translateY(-50%); font-size: 24px; font-weight: 400; color: var(--orange-2); }
      .faq[open] summary::after { content: '\2013'; }
      .faq p { margin: 0; padding: 0 0 20px; color: var(--muted); }
      .final { background: radial-gradient(70% 80% at 50% 100%, rgb(245 130 32 / 0.16), transparent 70%); }
      .final-logo { width: min(360px, 78vw); height: auto; margin: 0 auto 40px; }
      .final .lead { margin: 16px auto 32px; }
      .final .cta-note { margin-top: 14px; }
      .footer { border-top: 1px solid var(--line); padding: 44px 0 calc(120px + env(safe-area-inset-bottom)); }
      @media (min-aspect-ratio: 1/1) { .footer { padding-bottom: 56px; } }
      .foot-logo { height: 34px; width: auto; margin-bottom: 20px; }
      .disclaimer { font-size: 13px; line-height: 1.6; color: var(--dim); max-width: 760px; margin: 0 0 10px; }
      .disclaimer.small { font-size: 12px; }
      .copyright { font-size: 12px; color: var(--dim); margin: 22px 0 0; padding-top: 18px; border-top: 1px solid var(--line); }

      .sticky-cta { display: none; }
      @media (max-aspect-ratio: 1/1) {
        .sticky-cta {
          display: block; position: fixed; left: 0; right: 0; bottom: 0; z-index: 45;
          padding: 12px var(--pad-x) calc(12px + env(safe-area-inset-bottom));
          background: linear-gradient(0deg, rgb(0 4 17 / 0.96) 40%, rgb(0 4 17 / 0));
        }
        .sticky-cta .btn { width: 100%; }
        .top .btn-sm { display: none; }
      }
      @media (prefers-reduced-motion: reduce) {
        .btn, #seq, .rail button, .rail button span { transition: none; }
        .hint span { animation: none; }
      }
    </style>
  </body>
</html>
