---
// SpamClaims 3D landing page. One mission: the CTA.
// Every CTA points at the SpamClaims app and forwards this page's query string (see inline script at the bottom).
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = (import.meta.env.SITE || 'https://themoee.github.io').replace(/\/$/, '');
const canonical = `${site}${base}/`;
const year = new Date().getFullYear();
const CTA_HREF = 'https://spamclaims.com/lp/stop?lp=3d';
const title = 'You said STOP. They kept texting. | SpamClaims';
const fontFace = `@font-face{font-family:'Archivo Black';font-style:normal;font-weight:400;font-display:swap;src:url(${base}/fonts/archivo-black-latin-400-normal.woff2) format('woff2')}`;
const description =
  'Still getting marketing texts after you replied STOP? Upload your screenshots and see if they may qualify for attorney review. Free, 30 seconds, no sign-up.';

const threads = [
  {
    key: 'strong',
    tag: 'Strong pattern',
    sender: 'BrightSmile Dental',
    messages: [
      { kind: 'date', text: 'Mon, Mar 2 · 9:12 AM' },
      { kind: 'in', text: 'BrightSmile Dental: FLASH SALE. 40% off whitening this week only. Reply YES to claim!' },
      { kind: 'out', text: 'STOP' },
      { kind: 'gap', text: '16 days later' },
      { kind: 'date', text: 'Wed, Mar 18 · 6:04 PM' },
      { kind: 'in', text: 'BrightSmile Dental: Last chance! Your 40% discount expires Friday. Reply YES to lock it in.' },
    ],
    label: 'This pattern may be worth attorney review',
    tone: 'success',
    checks: [
      { ok: true, text: 'STOP visible' },
      { ok: true, text: 'Marketing continued afterward' },
      { ok: true, text: 'Dates visible' },
      { ok: true, text: 'Company identifiable' },
    ],
  },
  {
    key: 'maybe',
    tag: 'May qualify',
    sender: '+1 (833) 555-0147',
    messages: [
      { kind: 'in', text: 'Final notice: your vehicle warranty is about to expire. Call now to renew coverage.' },
      { kind: 'in', text: 'Your warranty quote is still available. Tap to claim before it is gone.' },
      { kind: 'out', text: 'STOP' },
      { kind: 'in', text: 'Reminder: do not lose coverage. Call today to extend your protection.' },
    ],
    label: 'May qualify. We need to see the screenshots',
    tone: 'highlight',
    checks: [
      { ok: true, text: 'STOP visible' },
      { ok: true, text: 'Marketing continued afterward' },
      { ok: false, text: 'Dates visible (unclear)' },
      { ok: false, text: 'Company identifiable (unclear)' },
    ],
  },
  {
    key: 'weak',
    tag: 'Weaker',
    sender: 'GlowFit',
    messages: [
      { kind: 'date', text: 'Today · 2:21 PM' },
      { kind: 'in', text: 'Thanks for signing up for GlowFit! Here is 10% off your first order: GLOW10' },
    ],
    label: 'This may be a weaker claim',
    tone: 'muted',
    checks: [
      { ok: false, text: 'STOP visible' },
      { ok: false, text: 'Marketing continued afterward' },
      { ok: true, text: 'Dates visible' },
      { ok: true, text: 'Company identifiable' },
    ],
  },
];

const steps = [
  { n: '1', title: 'Upload', text: 'Send us the screenshots.' },
  { n: '2', title: 'We investigate', text: 'We organize the messages and research the sender.' },
  { n: '3', title: 'Attorney review', text: 'A participating attorney evaluates the evidence and the law.' },
  { n: '4', title: 'If accepted', text: 'The lawyer takes it from there.' },
];

const freePoints = [
  'Uploading your spam texts is 100% free',
  'Attorneys only get paid if your case wins',
  'No cost to see if your claim qualifies',
];

const faqs = [
  {
    q: 'Do I need to go to court?',
    a: 'Most TCPA claims are resolved without you ever stepping into a courtroom. If a case proceeds, the attorney handles it.',
  },
  {
    q: 'What types of texts qualify?',
    a: "Unsolicited marketing texts, debt collection texts you didn't authorize, texts that ignore your STOP reply, and texts sent during quiet hours (before 8 a.m. or after 9 p.m. local time).",
  },
  {
    q: 'Is this actually free?',
    a: 'Yes. Uploading and reviewing your screenshots costs nothing. Attorneys typically work on contingency — they only get paid if you win.',
  },
  {
    q: 'How long does a claim take?',
    a: 'It varies. Some claims resolve in a few months, others take longer depending on the facts and the company involved.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#140c28" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="any" />
    <link rel="icon" type="image/png" sizes="512x512" href={`${base}/favicon-512.png`} />
    <link rel="apple-touch-icon" href={`${base}/favicon-512.png`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SpamClaims" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site}${base}/og.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A 3D STOP sign slamming onto a phone full of spam texts" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site}${base}/og.jpg`} />

    <!-- Display font is self-hosted and preloaded (LCP headline); the rest come from Google Fonts with swap. -->
    <link rel="preload" href={`${base}/fonts/archivo-black-latin-400-normal.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Hind:wght@400;500;600&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Hind:wght@400;500;600&display=swap" />
    </noscript>
    <style is:inline set:html={fontFace}></style>
  </head>
  <body>
    <!-- HERO: the wrapper is taller than the screen so scrolling the first screen drives the STOP slam -->
    <div class="hero-wrap" id="hero-wrap">
      <section class="hero" id="hero" aria-label="Intro">
        <header class="top">
          <a class="wordmark" href={`${base}/`} aria-label="SpamClaims">SpamClaims</a>
        </header>
        <div class="hero-bg" aria-hidden="true">
          <div class="poster" style={`background-image:url(${base}/poster.webp)`}></div>
          <canvas id="hero-canvas"></canvas>
          <div class="hero-shade"></div>
        </div>
        <div class="hero-content">
          <h1 class="h1">
            <span class="line1">YOU SAID STOP.</span>
            <span class="line2">THEY KEPT TEXTING.</span>
          </h1>
          <p class="sub">See if your screenshots may qualify.</p>
          <p class="badges" aria-label="Free, 30 seconds, no sign-up">
            <span>FREE</span><span class="dot">·</span><span>30 SECONDS</span><span class="dot">·</span><span>NO SIGN-UP</span>
          </p>
          <a class="btn btn-cta" data-cta href={CTA_HREF}>CHECK MY TEXTS</a>
        </div>
      </section>
    </div>

    <main>
      <!-- 2. DO YOUR TEXTS LOOK LIKE THIS? -->
      <section class="section" id="patterns">
        <div class="container">
          <p class="eyebrow">Pattern check</p>
          <h2 class="h2">DO YOUR TEXTS<br />LOOK LIKE THIS?</h2>
          <div class="threads">
            {threads.map((t) => (
              <article class={`thread tone-${t.tone}`}>
                <div class="thread-tag">{t.tag}</div>
                <div class="phone-frame" aria-label={`Example text thread from ${t.sender}`}>
                  <div class="phone-header">
                    <span class="avatar" aria-hidden="true">?</span>
                    <span class="sender">{t.sender}</span>
                  </div>
                  <div class="msgs">
                    {t.messages.map((m) =>
                      m.kind === 'in' ? (
                        <div class="msg in">{m.text}</div>
                      ) : m.kind === 'out' ? (
                        <div class="msg out">{m.text}</div>
                      ) : m.kind === 'gap' ? (
                        <div class="gap"><span>{m.text}</span></div>
                      ) : (
                        <div class="date">{m.text}</div>
                      ),
                    )}
                  </div>
                </div>
                <p class="verdict">{t.label}</p>
                <ul class="checks">
                  {t.checks.map((c) => (
                    <li class={c.ok ? 'ok' : 'no'}>
                      <span class="mark" aria-hidden="true">{c.ok ? '✓' : '✕'}</span>
                      <span>{c.text}</span>
                    </li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
          <div class="center">
            <a class="btn btn-cta" data-cta href={CTA_HREF}>UPLOAD MY SCREENSHOTS</a>
          </div>
        </div>
      </section>

      <!-- 3. HOW IT WORKS -->
      <section class="section section-alt" id="how">
        <div class="container">
          <p class="eyebrow">Simple</p>
          <h2 class="h2">HOW IT WORKS</h2>
          <ol class="steps">
            {steps.map((s) => (
              <li class="step">
                <span class="step-n" aria-hidden="true">{s.n}</span>
                <h3 class="h3">{s.title}</h3>
                <p>{s.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- 4. FREE TO CHECK -->
      <section class="section" id="free">
        <div class="container narrow">
          <div class="card card-pop">
            <span class="zero" aria-hidden="true">$0</span>
            <p class="eyebrow accent">Zero risk</p>
            <h2 class="h2 tight">FREE TO CHECK. <span class="hl">ALWAYS.</span></h2>
            <ul class="bullets">
              {freePoints.map((p) => (
                <li><span class="mark ok" aria-hidden="true">✓</span><span>{p}</span></li>
              ))}
            </ul>
            <p class="fine">
              Statutory damages under the TCPA range from <strong class="money">$500</strong> per violation up to
              <strong class="money">$1,500</strong> per willful violation. Actual recovery varies depending on the facts and applicable law.
            </p>
          </div>
        </div>
      </section>

      <!-- 5. DON'T DELETE THE EVIDENCE -->
      <section class="section section-alt" id="evidence">
        <div class="container narrow">
          <div class="card card-warn">
            <p class="eyebrow accent">Heads up</p>
            <h2 class="h2 tight">DON'T DELETE<br />THE EVIDENCE.</h2>
            <p class="lead">
              Old messages disappear when phones are replaced, conversations are deleted or screenshots are lost. If you have
              the thread now, preserve it now. Legal deadlines can apply to consumer claims.
            </p>
          </div>
        </div>
      </section>

      <!-- 6. REVIEWED BY ATTORNEYS -->
      <section class="section" id="attorneys">
        <div class="container narrow center">
          <p class="eyebrow">Real review</p>
          <h2 class="h2">REVIEWED BY LICENSED<br />CONSUMER-PROTECTION ATTORNEYS</h2>
          <p class="lead muted">
            Screenshots that pass our screening go to participating attorneys who focus on consumer-protection law. An
            attorney looks at your evidence and the applicable law and decides whether your claim is worth taking on. No
            promises, no pressure.
          </p>
        </div>
      </section>

      <!-- 7. FAQ -->
      <section class="section section-alt" id="faq">
        <div class="container narrow">
          <p class="eyebrow">Questions?</p>
          <h2 class="h2">REAL ANSWERS.</h2>
          <div class="faqs">
            {faqs.map((f) => (
              <details class="faq">
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <!-- 8. FINAL CTA -->
      <section class="section final" id="final">
        <div class="container narrow center">
          <h2 class="h2">STILL HAVE THE THREAD?</h2>
          <p class="lead">30 seconds. Free. No sign-up.</p>
          <a class="btn btn-cta big" data-cta href={CTA_HREF}>CHECK MY TEXTS</a>
          <p class="tiny">No cost to check</p>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="container">
        <p class="foot-brand">SpamClaims.com<sup>™</sup></p>
        <p class="disclaimer">
          This website does not provide legal advice. Submitting information does not create an attorney-client
          relationship. Results vary based on the facts and applicable law.
        </p>
        <p class="disclaimer small">
          SpamClaims.com provides consumer-submitted reporting and informational tools. Information displayed does not
          constitute legal advice or a determination of liability.
        </p>
        <p class="copyright">© {year} SpamClaims.com™</p>
      </div>
    </footer>

    <!-- Sticky CTA bar (mobile), shown once the hero has scrolled away -->
    <div class="sticky-cta" id="sticky-cta" aria-hidden="true">
      <a class="btn btn-cta" data-cta href={CTA_HREF} tabindex="-1">CHECK MY TEXTS</a>
    </div>

    <!-- Inline: forward every query param to the app (+ lp=3d, vv), and detect WebGL. No bundling, runs immediately. -->
    <script is:inline>
      (function () {
        try {
          var p = new URLSearchParams(location.search);
          p.set('lp', '3d');
          // vv is the AD VIDEO variant and stays whatever the ad put on the URL; this page is the lp, not a video.
          var qs = p.toString();
          var links = document.querySelectorAll('a[data-cta]');
          for (var i = 0; i < links.length; i++) links[i].href = 'https://spamclaims.com/lp/stop?' + qs;
        } catch (e) {}
        var ok = false;
        try {
          var c = document.createElement('canvas');
          ok = !!(window.WebGLRenderingContext && (c.getContext('webgl2') || c.getContext('webgl')));
        } catch (e) {}
        if (!ok) document.documentElement.classList.add('no-webgl');
        if (/[?&]poster=1/.test(location.search)) document.documentElement.classList.add('poster-mode');
      })();
    </script>

    <!-- Bundled: sticky bar + lazy 3D hero (three.js is code-split and loaded after first paint). -->
    <script>
      const hero = document.getElementById('hero') as HTMLElement;
      const wrap = document.getElementById('hero-wrap') as HTMLElement;
      const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement;
      const bar = document.getElementById('sticky-cta') as HTMLElement;

      // sticky bottom CTA once the hero is out of view
      const barIO = new IntersectionObserver(
        (entries) => {
          const gone = !entries[0].isIntersecting;
          bar.classList.toggle('show', gone);
          bar.setAttribute('aria-hidden', gone ? 'false' : 'true');
          bar.querySelector('a')?.setAttribute('tabindex', gone ? '0' : '-1');
        },
        { threshold: 0 },
      );
      barIO.observe(hero);

      const root = document.documentElement;
      const base = import.meta.env.BASE_URL.replace(/\/$/, '');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const isMobile = window.matchMedia('(pointer: coarse)').matches || window.innerWidth < 900;
      // ?poster=1 (text hidden) and ?og=1 (text kept) both render the deterministic "after the slam" frame.
      const poster = root.classList.contains('poster-mode') || /[?&]og=1(&|$)/.test(location.search);

      async function boot() {
        if (root.classList.contains('no-webgl')) return;
        try {
          const { initHero } = await import('../scripts/hero3d');
          await initHero(canvas, { base, reducedMotion, isMobile, hero, wrap, poster });
          hero.classList.add('has-3d');
        } catch (err) {
          console.warn('[hero3d] failed, keeping the poster', err);
          root.classList.add('no-webgl');
        }
      }
      const schedule = () => {
        if ('requestIdleCallback' in window) (window as any).requestIdleCallback(boot, { timeout: 1200 });
        else setTimeout(boot, 200);
      };
      if (document.readyState === 'complete') schedule();
      else window.addEventListener('load', schedule, { once: true });
    </script>

    <style is:global>
      /* ------------------------------------------------ tokens (SpamClaims "genz" theme) */
      :root {
        --bg: hsl(258 54% 10%);
        --bg-2: hsl(258 50% 13%);
        --card: hsl(258 45% 17%);
        --fg: #ffffff;
        --primary: hsl(249 100% 68%);
        --accent: hsl(334 100% 68%);
        --highlight: hsl(48 100% 70%);
        --highlight-fg: hsl(258 54% 11%);
        --success: hsl(152 76% 55%);
        --muted: hsl(258 40% 20%);
        --muted-fg: hsl(258 25% 80%);
        --border: hsl(258 40% 28%);
        --radius: 18px;
        --display: 'Archivo Black', 'Montserrat', Arial, sans-serif;
        --sans: 'Montserrat', Arial, sans-serif;
        --body: 'Hind', 'Montserrat', Arial, sans-serif;
        --shadow-hard: 6px 6px 0 0 var(--highlight);
        --shadow-hard-pink: 6px 6px 0 0 var(--accent);
        --gutter: 16px;
        color-scheme: dark;
      }
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
      html, body { margin: 0; background: var(--bg); color: var(--fg); overflow-x: hidden; }
      body {
        font-family: var(--body);
        font-size: 17px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        padding-bottom: 0;
      }
      img, canvas { display: block; max-width: 100%; }
      a { color: inherit; }
      .container { width: 100%; max-width: 1180px; margin: 0 auto; padding: 0 var(--gutter); }
      .container.narrow { max-width: 760px; }
      .center { text-align: center; }

      /* type */
      .h1, .h2, .h3, .wordmark, .btn, .step-n, .zero, .foot-brand { font-family: var(--display); font-weight: 400; letter-spacing: -0.01em; }
      .h2 { font-size: clamp(30px, 6.2vw, 52px); line-height: 1.02; margin: 0 0 28px; text-wrap: balance; }
      .h2.tight { margin-bottom: 20px; }
      .h3 { font-size: 20px; margin: 10px 0 6px; }
      .eyebrow { font-family: var(--sans); font-weight: 800; font-size: 12px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--primary); margin: 0 0 10px; }
      .eyebrow.accent { color: var(--accent); }
      .lead { font-size: 19px; line-height: 1.55; margin: 0; }
      .muted { color: var(--muted-fg); }
      .hl { color: var(--highlight); }
      .tiny { font-size: 13px; color: var(--muted-fg); margin: 12px 0 0; }

      /* buttons */
      .btn {
        display: inline-flex; align-items: center; justify-content: center; gap: 10px;
        min-height: 56px; padding: 14px 30px; border-radius: 999px;
        font-size: 17px; letter-spacing: 0.04em; text-decoration: none; text-align: center;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
        -webkit-tap-highlight-color: transparent;
      }
      .btn-cta { background: var(--highlight); color: var(--highlight-fg); box-shadow: var(--shadow-hard-pink); }
      .btn-cta:hover { transform: translate(-2px, -2px); box-shadow: 8px 8px 0 0 var(--accent); }
      .btn-cta:active { transform: translate(3px, 3px); box-shadow: 2px 2px 0 0 var(--accent); }
      .btn-cta:focus-visible { outline: 3px solid var(--fg); outline-offset: 3px; }
      .btn.big { font-size: 20px; min-height: 64px; padding: 16px 40px; }

      /* header (wordmark only) */
      .top { position: absolute; top: 0; left: 0; right: 0; z-index: 5; padding: 18px var(--gutter); padding-top: max(18px, env(safe-area-inset-top)); pointer-events: none; }
      .wordmark { font-size: 20px; text-decoration: none; color: var(--fg); pointer-events: auto; text-shadow: 0 2px 12px rgb(0 0 0 / 0.5); }

      /* ------------------------------------------------ hero */
      .hero-wrap { height: 165vh; height: 165svh; position: relative; }
      .hero { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; background: radial-gradient(120% 90% at 70% 60%, hsl(266 60% 18%) 0%, var(--bg) 60%); }
      .hero-bg { position: absolute; inset: 0; }
      .hero-bg .poster { position: absolute; inset: 0; background-size: cover; background-position: 62% 55%; opacity: 1; transition: opacity 0.8s ease; }
      .hero.has-3d .poster { opacity: 0; }
      html.no-webgl .hero-bg canvas { display: none; }
      #hero-canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
      .hero-shade {
        position: absolute; inset: 0; pointer-events: none;
        background:
          linear-gradient(180deg, hsl(258 54% 10% / 0.92) 0%, hsl(258 54% 10% / 0.55) 46%, hsl(258 54% 10% / 0) 62%),
          linear-gradient(0deg, var(--bg) 0%, hsl(258 54% 10% / 0) 18%);
      }
      html.poster-mode .hero-shade, html.poster-mode .hero-content, html.poster-mode .top { visibility: hidden; }
      .hero-content {
        position: relative; z-index: 2; text-align: center;
        max-width: 560px; margin: 0 auto;
        padding: calc(74px + env(safe-area-inset-top)) var(--gutter) 0;
      }
      .h1 { font-size: clamp(34px, 9.6vw, 58px); line-height: 1.0; margin: 0 0 14px; text-shadow: 0 4px 30px rgb(0 0 0 / 0.45); }
      .h1 .line1, .h1 .line2 { display: block; }
      .h1 .line2 { color: var(--accent); }
      .sub { font-family: var(--sans); font-weight: 600; font-size: clamp(17px, 4.4vw, 22px); margin: 0 0 12px; color: var(--fg); }
      .badges { display: flex; justify-content: center; flex-wrap: wrap; gap: 6px 8px; margin: 0 0 20px; font-family: var(--sans); font-weight: 800; font-size: 12px; letter-spacing: 0.18em; color: var(--highlight); }
      .badges .dot { color: var(--muted-fg); }
      @media (min-width: 900px) {
        .hero-shade {
          background:
            linear-gradient(90deg, hsl(258 54% 10% / 0.85) 0%, hsl(258 54% 10% / 0.45) 38%, hsl(258 54% 10% / 0) 58%),
            linear-gradient(0deg, var(--bg) 0%, hsl(258 54% 10% / 0) 16%);
        }
        .hero-content { position: absolute; left: 0; top: 50%; transform: translateY(-50%); text-align: left; margin: 0; max-width: none; width: 58%; padding: 0 0 0 max(5vw, var(--gutter)); }
        .h1 { font-size: clamp(40px, 4.2vw, 72px); }
        .h1 .line1, .h1 .line2 { white-space: nowrap; }
        .badges { justify-content: flex-start; font-size: 13px; }
        .sub { margin-bottom: 16px; }
      }

      /* ------------------------------------------------ sections */
      .section { padding: 72px 0; position: relative; }
      .section-alt { background: var(--bg-2); }
      @media (min-width: 900px) { .section { padding: 104px 0; } }

      /* threads */
      .threads { display: grid; gap: 28px; margin: 0 0 36px; }
      @media (min-width: 900px) { .threads { grid-template-columns: repeat(3, 1fr); gap: 24px; } }
      .thread { position: relative; border: 2px solid var(--border); border-radius: 24px; background: var(--card); padding: 18px 16px 20px; }
      .thread.tone-success { border-color: var(--success); }
      .thread.tone-highlight { border-color: var(--highlight); }
      .thread-tag { position: absolute; top: -12px; left: 16px; font-family: var(--sans); font-weight: 800; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; padding: 4px 10px; border-radius: 999px; background: var(--muted); color: var(--fg); }
      .tone-success .thread-tag { background: var(--success); color: var(--highlight-fg); }
      .tone-highlight .thread-tag { background: var(--highlight); color: var(--highlight-fg); }
      .phone-frame { background: #0b0919; border-radius: 22px; border: 3px solid #241c45; padding: 10px 12px 14px; }
      .phone-header { display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 4px 0 10px; border-bottom: 1px solid #1f1a3a; margin-bottom: 10px; font-family: var(--sans); font-size: 12px; font-weight: 600; color: var(--muted-fg); }
      .avatar { width: 30px; height: 30px; border-radius: 50%; background: hsl(249 50% 45%); display: grid; place-items: center; font-weight: 800; color: #fff; }
      .msgs { display: flex; flex-direction: column; gap: 7px; }
      .msg { max-width: 86%; padding: 9px 13px; border-radius: 18px; font-size: 14px; line-height: 1.38; font-family: -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; }
      .msg.in { align-self: flex-start; background: #2d2a45; color: #fff; border-bottom-left-radius: 5px; }
      .msg.out { align-self: flex-end; background: #34c759; color: #fff; font-weight: 700; border-bottom-right-radius: 5px; }
      .date { text-align: center; font-size: 11px; color: #8d86b3; margin: 2px 0; }
      .gap { display: flex; align-items: center; gap: 10px; margin: 6px 0; font-family: var(--sans); font-weight: 800; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--highlight); }
      .gap::before, .gap::after { content: ''; flex: 1; height: 1px; background: #3a3160; }
      .verdict { font-family: var(--sans); font-weight: 800; font-size: 15px; margin: 16px 0 10px; }
      .tone-success .verdict { color: var(--success); }
      .tone-highlight .verdict { color: var(--highlight); }
      .tone-muted .verdict { color: var(--muted-fg); }
      .checks { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; font-size: 14px; }
      .checks li { display: flex; align-items: center; gap: 8px; }
      .checks .no { color: var(--muted-fg); }
      .mark { display: inline-grid; place-items: center; width: 20px; height: 20px; border-radius: 50%; font-size: 12px; font-weight: 800; background: var(--muted); color: var(--muted-fg); flex: none; }
      .ok .mark, .mark.ok { background: var(--success); color: var(--highlight-fg); }

      /* steps */
      .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 18px; counter-reset: step; }
      @media (min-width: 720px) { .steps { grid-template-columns: repeat(2, 1fr); } }
      @media (min-width: 1000px) { .steps { grid-template-columns: repeat(4, 1fr); } }
      .step { background: var(--card); border: 2px solid var(--border); border-radius: var(--radius); padding: 22px 20px 20px; }
      .step p { margin: 0; color: var(--muted-fg); }
      .step-n { display: inline-grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; background: linear-gradient(135deg, var(--accent), var(--primary)); color: #fff; font-size: 20px; }

      /* cards */
      .card { position: relative; background: var(--card); border: 2px solid var(--border); border-radius: 28px; padding: 32px 22px; }
      @media (min-width: 720px) { .card { padding: 44px 48px; } }
      .card-pop { border-color: var(--accent); box-shadow: var(--shadow-hard); }
      .card-warn { border-color: var(--accent); box-shadow: var(--shadow-hard-pink); }
      .zero { position: absolute; top: -22px; right: 14px; width: 72px; height: 72px; border-radius: 50%; background: var(--highlight); color: var(--highlight-fg); display: grid; place-items: center; font-size: 24px; transform: rotate(-8deg); }
      .bullets { list-style: none; margin: 0 0 22px; padding: 0; display: grid; gap: 12px; }
      .bullets li { display: flex; align-items: flex-start; gap: 12px; font-family: var(--sans); font-weight: 600; font-size: 17px; }
      .bullets .mark { width: 24px; height: 24px; margin-top: 1px; }
      .fine { font-size: 13px; line-height: 1.55; color: var(--muted-fg); margin: 0; border-top: 1px solid var(--border); padding-top: 16px; }
      .money { color: var(--highlight); font-family: var(--display); font-weight: 400; }

      /* faq */
      .faqs { display: grid; gap: 10px; }
      .faq { background: var(--card); border: 2px solid var(--border); border-radius: 18px; padding: 0 18px; transition: border-color 0.2s; }
      .faq[open] { border-color: var(--accent); }
      .faq summary { cursor: pointer; list-style: none; padding: 18px 28px 18px 0; font-family: var(--sans); font-weight: 700; font-size: 16px; position: relative; }
      .faq summary::-webkit-details-marker { display: none; }
      .faq summary::after { content: '+'; position: absolute; right: 2px; top: 50%; transform: translateY(-50%); font-family: var(--display); font-size: 22px; color: var(--highlight); }
      .faq[open] summary::after { content: '–'; }
      .faq p { margin: 0; padding: 0 0 18px; color: var(--muted-fg); font-size: 15px; }

      /* final + footer */
      .final { background: radial-gradient(80% 70% at 50% 100%, hsl(300 55% 20%) 0%, var(--bg) 70%); }
      .final .lead { margin: 0 0 24px; color: var(--muted-fg); font-family: var(--sans); font-weight: 600; }
      .footer { border-top: 2px solid var(--border); padding: 40px 0 calc(110px + env(safe-area-inset-bottom)); background: var(--bg); }
      @media (min-width: 900px) { .footer { padding-bottom: 48px; } }
      .foot-brand { font-size: 18px; margin: 0 0 12px; }
      .foot-brand sup { font-size: 10px; margin-left: 2px; }
      .disclaimer { font-size: 13px; line-height: 1.6; color: var(--muted-fg); max-width: 720px; margin: 0 0 10px; }
      .disclaimer.small { font-size: 12px; opacity: 0.8; }
      .copyright { font-size: 12px; color: var(--muted-fg); margin: 24px 0 0; padding-top: 18px; border-top: 1px solid var(--border); }

      /* sticky mobile CTA */
      .sticky-cta {
        position: fixed; left: 0; right: 0; bottom: 0; z-index: 50;
        padding: 10px var(--gutter) calc(10px + env(safe-area-inset-bottom));
        background: linear-gradient(0deg, hsl(258 54% 8% / 0.98), hsl(258 54% 8% / 0.9));
        border-top: 1px solid var(--border);
        transform: translateY(110%); transition: transform 0.3s ease;
      }
      .sticky-cta.show { transform: translateY(0); }
      .sticky-cta .btn { width: 100%; box-shadow: none; }
      @media (min-width: 900px) { .sticky-cta { display: none; } }
      @media (prefers-reduced-motion: reduce) {
        .btn, .sticky-cta, .hero-bg .poster, .faq { transition: none; }
      }
    </style>
  </body>
</html>
